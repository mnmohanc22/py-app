[Unit]
Description=MyApp Flask/Gunicorn
After=network.target postgresql.service

[Service]
User=wlsapps
Group=wlsapps
WorkingDirectory=/opt/myapp

# .env file sits in WorkingDirectory — no env vars needed here
# Only override if .env is missing something critical
# Environment="SECRET_KEY=fallback-only"

RuntimeDirectory=myapp
LogsDirectory=myapp

ExecStart=/opt/myapp/venv/bin/gunicorn \
    "wsgi:application" \
    --config gunicorn.conf.py

# Reload workers + reopen log files (no downtime)
ExecReload=/bin/kill -USR1 $MAINPID

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target