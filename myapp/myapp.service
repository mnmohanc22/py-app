[Unit]
Description=MyApp Flask/Gunicorn
Documentation=https://github.com/yourorg/myapp
After=network.target postgresql.service

[Service]
User=wlsapps
Group=wlsapps
WorkingDirectory=/opt/myapp

# .env file in WorkingDirectory is loaded by wsgi.py via python-dotenv
# Only set overrides here if absolutely needed outside .env
# Environment="SECRET_KEY=emergency-override"

# systemd creates these dirs automatically before start
RuntimeDirectory=myapp          # → /var/run/myapp  (for gunicorn.pid)
LogsDirectory=myapp             # → /var/log/myapp  (for log files)
RuntimeDirectoryMode=0755
LogsDirectoryMode=0755

ExecStart=/opt/myapp/venv/bin/gunicorn \
    "wsgi:application" \
    --config gunicorn.conf.py

# Sends USR1 to gunicorn master → workers gracefully reopen log files
# Used by: systemctl reload myapp
ExecReload=/bin/kill -USR1 $MAINPID

# Graceful stop — gunicorn finishes in-flight requests before exit
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/myapp /var/run/myapp /opt/myapp

[Install]
WantedBy=multi-user.target
