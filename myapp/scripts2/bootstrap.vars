# /opt/scripts/bootstrap.vars

# ── App identity ──────────────────────────────────────────────────
APP_NAME=myapp
APP_USER=wlsapps
APP_GROUP=wlsapps
APP_PORT=8001
PYTHON_MIN_VERSION=3.8

# ── Project root — parent of everything ──────────────────────────
PROJECT_ROOT=/opt/myapp-project

# ── All dirs relative to PROJECT_ROOT ────────────────────────────
APP_RELATIVE=app
RELEASES_RELATIVE=releases
CONFIGS_RELATIVE=configs
GUNICORN_CONF_RELATIVE=configs/gunicorn
LOGS_RELATIVE=logs
RUN_RELATIVE=run
VENV_RELATIVE=venv              # venv now under project root

# ── Scripts ───────────────────────────────────────────────────────
SCRIPTS_DIR=/opt/scripts

# ── Secrets — only this lives outside project root ────────────────
ENVS_DIR=/opt/envs
ENV_FILE=/opt/envs/myapp.env

# ── Requirements — relative to APP_DIR ───────────────────────────
REQUIREMENTS_FILE=requirements.txt